/*
 * vii3_media.dll 的版本信息（VERSIONINFO），由 build-vii3-media.sh 用 windres
 * 编成 .o 后链进 dll（缺省路径按 VII3_SHIM 所在目录推：Native/vii3_media.rc）。
 *
 * 内嵌的第三方库：
 *   FFmpeg（LGPL，见 build-vii3-media.sh 里的 --disable-gpl）
 *   libavif（BSD-2-Clause，v1.4.2）
 *   dav1d（BSD-2-Clause）
 */
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"
        BEGIN
            VALUE "CompanyName", "vvyoko"
            VALUE "FileDescription", "Vii3 Media Native"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "vii3_media"
            VALUE "LegalCopyright", "Copyright (c) 2026"
            VALUE "OriginalFilename", "vii3_media.dll"
            VALUE "ProductName", "Vii3"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "FFmpeg (LGPL) + libavif (BSD-2-Clause) + dav1d (BSD-2-Clause)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END
